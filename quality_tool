# to jest uzupełniający skrypt do main, ktory ma generować raport stanu bazy czy np nie ma blank records albo dubli etc
import psycopg2
from dotenv import load_dotenv
import os

def connection():
    load_dotenv()

    DB_PARAMS={
        "dbname": os.getenv('DB_NAME'),
        "user": os.getenv('DB_USER'),
        "password": os.getenv('DB_PASSWORD'),
        "host": os.getenv('DB_HOST'),
        "port": os.getenv('DB_PORT')
    }

    try:
        with psycopg2.connect(**DB_PARAMS) as conn:
                    with conn.cursor() as cursor:
                        cursor.execute('SELECT VERSION();')
                        db_version = cursor.fetchone()
                        print(f'Połączono z bazą wersja {db_version}.')
                        return conn
        
    except Exception as e:
        print(f'Wystapił błąd podczas łączenia z bazą danych: {e}.')

def blank_records_check(conn):
    print("\nBLANK RECORD CHECK UP")
    # structured: ((tab1_name,(col1,col2..)),(tab2,(col1,col2..)),..)
    tables = (('public.pacjenci',('id_pacjenta','imie','nazwisko','pesel','data_urodzenia','plec')),
            ('public.lekarze',('id_lekarza','imie','nazwisko','specjalizacja')),
            ('public.skierowania',('id_skierowania','id_pacjenta','id_lekarza','nazwa_badania','data_skierowania','wstepne_rozpoznanie','status','lokalizacja')),
            ('public.badania',('id_badania','id_skierowania','data_badania','id_radiologa','opis')),
            ('public.tk',('id_badania','dawka_prom','kontrast','tryb')),
            ('public.rtg',('id_badania','dawka_prom','projekcja','pozycja')),
            ('public.mri',('id_badania','pole_magn','kontrast','protokol')),
            ('public.usg',('id_badania','glowica','doppler','czestotliwosc')))
    for tab in tables:
        corrupted=[]
        print(f"\nTable {tab[0]}:")
        for col in tab[1][1:]:
            with conn.cursor() as cursor:
                cursor.execute(f"SELECT {tab[1][0]} FROM {tab[0]} WHERE {col} IS NULL;",)
                catch = cursor.fetchone()
                if catch==None:
                    continue
                else:
                    corrupted.append(catch)
        if corrupted==[]:
            print(f"No blank spots in table {tab[0]}.")
        else:
            print(f"Found blank spots in table {tab[0]}. IDs:")
            for el in corrupted:
                print(el)

