    except Exception as e:
        print(f'Wystapił błąd podczas łączenia z bazą danych: {e}.')

def wyszukanie_pacjenta(conn):
    while True:
        imie_pac = input("Imię pacjenta: ").strip().lower()
        nazwisko_pac = input("Nazwisko pacjenta: ").strip().lower()
        with conn.cursor() as cursor:
            cursor.execute("SELECT * FROM public.pacjenci WHERE imie = %s AND nazwisko = %s;",(imie_pac,nazwisko_pac))
            pacjent = cursor.fetchone()
            if not pacjent:
                print("Nie znaleziono pacjenta w bazie.")
                continue
            print(f"Znaleziono pacjent: {pacjent[1].capitalize()} {pacjent[2].capitalize()}, PESEL: {pacjent[3]}")
            potw = input("Potwierdź wybranie pacjenta (tak/nie): ").strip().lower()
            if potw=='tak' or potw=='t':
                id_p = pacjent[0]
                return id_p, imie_pac, nazwisko_pac
            elif potw=='nie' or potw=='n':
                dalej = input("Czy chcesz wybrać innego pacjenta (tak/nie): ").strip().lower()
                if dalej=='tak' or dalej=='t':
                    continue
                else:
                    print("Powrót do menu głównego.")
                    return None, None, None
            else:
                print("Błąd wprowadzania. Niezana komenda.")
                continue

