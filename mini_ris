def wyszukanie_skierowania(conn):
    while True:
        imie_pac = input("Imię pacjenta: ").strip().lower()
        nazwisko_pac = input("Nazwisko pacjenta: ").strip().lower()
        
        with conn.cursor() as cursor:
            cursor.execute("""SELECT * FROM public.skierowania AS s
            JOIN public.pacjenci AS p ON s.id_pacjenta = p.id_pacjenta 
            WHERE imie=%s AND nazwisko=%s 
            ORDER BY s.data_skierowania DESC;""", (imie_pac,nazwisko_pac))
            skierowania = cursor.fetchall()
        if not skierowania:
            print(f"Nie znaleziono skierowań dla pacjenta {imie_pac.capitalize()} {nazwisko_pac.capitalize()}.")
            dalej = input("Czy chcesz wyszukać innego pacjenta (tak/nie): ")
            if dalej=='tak' or dalej=='t':
                continue
            else:
                print("Powrót do menu głównego.")
                return None
        print(f"\nSkierowania pacjenta {imie_pac.capitalize()} {nazwisko_pac.capitalize()}:")
        ids=[]
        for skr in skierowania:
            ids.append(skr[0])
            print(f"""ID: {skr[0]}
{skr[3].upper()} {skr[7]} 
Data wystawienia skierowania: {skr[4]}
Wstępne rozpoznanie: {skr[5]}
Status: {skr[6]}""")
        return ids

