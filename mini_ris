FROM public.pacjenci AS p
LEFT JOIN public.skierowania AS s ON p.id_pacjenta=s.id_pacjenta
LEFT JOIN public.badania AS b ON s.id_skierowania=b.id_skierowania
WHERE b.data_badania=%s;""",(data,))
        plec_statystyki = cursor.fetch()
    
    print(f"""STATYSTYKI Z DNIA - {data}
