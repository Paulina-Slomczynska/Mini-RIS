def dodanie_pacjenta(conn):
    print("\nWPROWADZANIE NOWEGO PACJENTA")
    imie = input("Imię: ")
    imie = imie.lower().strip()
    nazwisko = input("Nazwisko: ")
    nazwisko = nazwisko.lower().strip()
    while True:
        pesel = input("PESEL: ").strip()
        if len(pesel)==11 and pesel.isdigit()==True:
            break
        else:
            print("Nieprawidłowy PESEL.")
    if pesel[2]>='2':
        rok = '20'+pesel[0]+pesel[1]
        rok = int(rok)
        miesiac = int(pesel[2]+pesel[3]) - 20
        dzien = int(pesel[4]+pesel[5])
    else:
        rok = int('19' + pesel[0] +pesel[1])
        miesiac = int(pesel[2]+pesel[3])
        dzien = int(pesel[4]+pesel[5])
    data_urodzenia = date(rok,miesiac,dzien)
    while True:
        plec = input("Płeć: (K/M) ")
        plec = plec.upper().strip()
        if plec == 'K' or plec == 'M':
            break
        elif plec == 'F':
            plec = 'K'
            break
        else:
            print("Wprowadzono nieprawidłową płeć.")

    with conn.cursor() as cursor:
        cursor.execute("INSERT INTO public.pacjenci(imie, nazwisko, pesel, data_urodzenia, plec) VALUES (%s,%s,%s,%s,%s);",(imie,nazwisko,pesel,data_urodzenia,plec))
        conn.commit()
    print(f"Pacjent {imie.capitalize()} {nazwisko.capitalize()} został pomyślnie dodany do bazy.")

