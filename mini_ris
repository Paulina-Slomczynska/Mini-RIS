Przebadano {plec_statystyki[0]} kobiet i {plec_statystyki[1]} męzczyzn.""")
    
    plt.bar(['TK','RTG','MRI','USG'],badania_statystyki,color=["#14583c", "#2bae59", "#38ea38", "#84f982"])
